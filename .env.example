# ---------------------------------------------------------------------------
# Asistente de IA Omnicanal - Muebles Jamar
# Copia este archivo como .env y completa las credenciales de Snowflake.
# El modo demo está desactivado; actívalo explícitamente solo para pruebas.
# ---------------------------------------------------------------------------

# --- Aplicación y red ---
ENVIRONMENT=production
LOG_LEVEL=INFO
FRONTEND_PORT=3000
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Telegram exige una URL pública HTTPS para los botones de Mini App.
# Con localhost el bot sigue funcionando, pero sin esos botones.
PUBLIC_WEBAPP_URL=http://localhost:3000
ASSET_BASE_URL=http://localhost:3000/products
BACKEND_INTERNAL_URL=http://backend:8000

# --- Snowflake (requerido para consultas de datos) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_TOKEN=
# PAT (Programmatic Access Token) de Snowflake; al definirlo se activa su autenticador.
# Para autenticación tradicional por contraseña, usa SNOWFLAKE_PASSWORD.
# Para SSO, usa "externalbrowser". La variable antigua SNOWFLAKE_PASSWORD sirve como PAT
# solo si SNOWFLAKE_AUTHENTICATOR=PROGRAMMATIC_ACCESS_TOKEN.
SNOWFLAKE_AUTHENTICATOR=
# --- Snowflake key-pair (recomendado para Docker) ---
# Genera la clave: openssl genrsa 2048 | openssl pkcs8 -topk8 -nocrypt -out secrets/snowflake_private_key.pem
# El contenedor corre como UID 10001: ejecuta chmod 644 secrets/snowflake_private_key.pem
# Registra la pública: ALTER USER <usuario> SET RSA_PUBLIC_KEY='<clave pública sin cabeceras>';
# Con SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE_JWT se usa la ruta o el base64 de la clave.
SNOWFLAKE_PRIVATE_KEY_PATH=/run/secrets/snowflake_private_key.pem
SNOWFLAKE_PRIVATE_KEY_B64=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_CLIENT_STORE_TEMPORARY_CREDENTIAL=false
SNOWFLAKE_DATABASE=JAMAR_DW
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=JAMAR_WH
SNOWFLAKE_ROLE=
SNOWFLAKE_INVENTORY_TABLE=INVENTARIO_PRODUCTOS
SNOWFLAKE_CUSTOMER_TABLE=CUSTOMER_360
SNOWFLAKE_FALLBACK_DEMO=false

# --- Inteligencia artificial (Google Gemini) ---
# Obtén la clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_VISION_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=40

# --- Telegram ---
# Crea el bot con @BotFather y pega aquí el token.
TELEGRAM_BOT_TOKEN=

# --- CrediJamar ---
CREDIT_WEEKLY_RATE=0.0045
CREDIT_MAX_TERM_WEEKS=52
CREDIT_MIN_DOWN_PAYMENT_PCT=0.10

# --- Horario de asesoría ---
ADVISOR_TIMEZONE=America/Bogota
ADVISOR_WEEKDAY_START=08:00
ADVISOR_WEEKDAY_END=18:00
ADVISOR_SATURDAY_START=09:00
ADVISOR_SATURDAY_END=13:00
ADVISOR_SUNDAY_ENABLED=false
ADVISOR_SUNDAY_START=09:00
ADVISOR_SUNDAY_END=13:00

# --- Servicios internos ---
# Compose sobreescribe API_BASE_URL dentro del contenedor del bot.
API_BASE_URL=http://backend:8000
